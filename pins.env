# The exact versions this recipe builds from. Checked 2026-10-31.
# Change a line here on purpose, never by accident.
# Plain KEY=value lines so both shell scripts and docker can read it.

# The weights (MIT). A repo can be re-uploaded; a commit hash can't change.
# main @ 2026-08-20
MODEL_REPO=inclusionAI/Ling-3.0-flash-fp4
MODEL_REVISION=3bae1cf4011b48475b2cc038fff283af49053ebc

# The engine: inclusionAI's SGLang fork, branch ling_v3_support_mxfp4_humming.
# Not merged upstream, and a branch can be force-pushed, so pin the commit.
# 2026-09-07 "feat: support Ling-3.0-flash Humming MoE, online FP8 LM head,
# and MTP on DGX Spark"
SGLANG_REPO=https://github.com/inclusionAI/sglang.git
SGLANG_COMMIT=079d4046003daf757d8a2daa44a3bb8935174b5e

# The Humming MoE kernels. Chosen by the fork's python/pyproject.toml, not by
# us (PyPI's latest is 0.1.18). Recorded so the build can check it got this.
# sha256 of humming_kernels-0.1.12-py3-none-manylinux_2_28_aarch64.whl
HUMMING_VERSION=0.1.12
HUMMING_SHA256=988e8b9da41e3679ae2816bdfb51acab53c05cc56254b5ca98e847f4efcf24fd

# The instructions we take flags from (not a build input).
# 2026-10-11 "docs: align sglang repo sources and annotate custom branches"
COOKBOOK_COMMIT=26f3e74ef8a78a794d61839da3f8ddb2eca78a14
